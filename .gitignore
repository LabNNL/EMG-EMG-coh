# macOS
.DS_Store

# MATLAB
*.asv

# Machine-specific paths (copy local_paths.template.m to create it)
config/local_paths.m

# Outputs. Everything under Results/ is regenerated by the pipeline and is
# untracked by design: it is ~290 MB, of which ~67 MB is figures.
# (An earlier attempt to track the PNGs could never work: git does not
# descend into an excluded directory, so a negation inside it has no effect.)
Results/*
Results_reworked/*
# Outdated results moved out of Results/ (older runs, stale and sync-conflict copies)
attic/ResultsArchive/

# Participant data and channel mapping: not public
Metadata/*
